---
import { Icon } from "astro-icon/components";
import aggregated from "../data/aggregated.json";
import ComparisonSelector from "./ComparisonSelector.astro";
import ConditioningInput from "./ConditioningInput.astro";
import BaselineSelector from "./BaselineSelector.astro";

const displayPrompts: Record<string, string> = {
  "iaHNa6cm64k-0:02:50.044-0:02:56.759":
    "Hold the stabilizer steady. Walk across the grassy area. Maintain the stabilizer's position. Ensure the camera stays balanced.",
  test_cab_e_3rd_00000_00081:
    "Camera tracks a black robot tailing a white one forward.",
};
const scenes = aggregated.cases.map((scene) => ({
  ...scene,
  prompt: displayPrompts[scene.id] ?? scene.prompt,
}));
const methods = [
  { id: "gen3r", name: "Gen3R" },
  { id: "tesseract", name: "TesserAct" },
  { id: "vist3a", name: "VIST3A" },
  { id: "plan4d", name: "Plan4D" },
] as const;
---

<section
  id="aggregated"
  class="section aggregate-section"
  data-pairwise-comparison
>
  <div class="section-heading wide-shell">
    <h2>Aggregated 4D Point Cloud</h2>
    <span class="section-count">{scenes.length} scenes</span>
  </div>
  <ComparisonSelector id="aggregated" scenes={scenes} />
  <div class="comparison-options wide-shell">
    <label class="check-control">
      <input id="aggregate-sync-views" type="checkbox" checked /> Linked views
    </label>
    <label class="point-control" for="aggregate-point-size">
      <Icon name="ri:focus-3-line" /> Point size
      <input
        id="aggregate-point-size"
        type="range"
        min="0.25"
        max="3"
        step="0.25"
        value="0.5"
      />
    </label>
    <div class="comparison-legend">
      <span class="method-dot"></span> Plan4D (ours)
    </div>
  </div>
  <div
    class="comparison-scroll wide-shell"
    data-comparison-scroll
    role="region"
    aria-label="Selected scene, baseline and Plan4D aggregated comparison"
  >
    <div class="aggregate-table">
      {
        scenes.map((scene, index) => (
          <article
            class="aggregate-row"
            id={`aggregated-scene-${index}`}
            hidden={index !== 0}
            data-case={scene.id}
            aria-label={scene.prompt}
          >
            <ConditioningInput
              image={scene.image}
              prompt={scene.prompt}
              index={index}
            />
            <div class="comparison-pair">
              {methods
                .filter(
                  (method) =>
                    scene.methods[method.id as keyof typeof scene.methods],
                )
                .map((method) => (
                  <div
                    class:list={[
                      "cloud-cell",
                      { "ours-cell": method.id === "plan4d" },
                    ]}
                    data-method={method.id}
                    data-sequence={scene.methods[method.id]}
                    hidden={method.id !== "gen3r" && method.id !== "plan4d"}
                  >
                    <div
                      class:list={[
                        "pair-method-heading",
                        { "ours-heading": method.id === "plan4d" },
                      ]}
                    >
                      <span
                        data-method-name
                        hidden={index === 0 && method.id === "gen3r"}
                      >
                        {method.name}
                        {method.id === "plan4d" && <small>Ours</small>}
                      </span>
                      {index === 0 && method.id === "gen3r" && (
                        <BaselineSelector
                          id="aggregate-baseline"
                          methods={methods}
                        />
                      )}
                      <span class="pair-output-label">
                        Aggregated point cloud
                      </span>
                    </div>
                    <div
                      class="viewer-surface"
                      tabindex="0"
                      role="img"
                      aria-label={`${method.name} aggregated 4D point cloud, scene ${index + 1}`}
                    >
                      <span class="cloud-status" role="status">
                        Loading point cloud
                      </span>
                      <button type="button" class="retry-button" hidden>
                        <Icon name="ri:refresh-line" /> Retry
                      </button>
                    </div>
                    <div class="cloud-tools">
                      <span class="cloud-method">{method.name}</span>
                      <button
                        type="button"
                        class="icon-button reset-view"
                        title="Reset view"
                        aria-label={`Reset ${method.name} view`}
                      >
                        <Icon name="ri:restart-line" />
                      </button>
                      <button
                        type="button"
                        class="icon-button expand-view"
                        title="Expand point cloud"
                        aria-label={`Expand ${method.name} point cloud`}
                        disabled
                      >
                        <Icon name="ri:fullscreen-line" />
                      </button>
                    </div>
                  </div>
                ))}
            </div>
            <p class="row-state" role="status" />
          </article>
        ))
      }
    </div>
  </div>
  <p class="comparison-note wide-shell">
    {
      aggregated.maxScenePoints
        ? `Up to ${aggregated.maxScenePoints.toLocaleString("en-US")} uniformly sampled scene points per method. `
        : "All source scene points are retained. "
    }
    All camera-frustum and trajectory points are retained. Each cloud uses its first
    camera orientation and an independent display scale.
  </p>
</section>
