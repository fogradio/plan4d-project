---
import { Icon } from "astro-icon/components";
import conditioningImages from "../data/conditioning-images.json";

interface Props {
  id: string;
  scenes: { id: string; image: string; prompt: string }[];
}

const { id, scenes } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<div class="scene-selector wide-shell" role="group" aria-label="Input scene">
  {
    scenes.map((scene, index) => {
      const fullImage =
        conditioningImages[scene.image as keyof typeof conditioningImages];
      return (
        <div class="scene-candidate">
          <button
            type="button"
            class="scene-choice"
            data-select-case={scene.id}
            aria-pressed={index === 0 ? "true" : "false"}
            aria-controls={`${id}-scene-${index}`}
            aria-label={`Scene ${index + 1}: ${scene.prompt}`}
            title={scene.prompt}
          >
            <img
              src={base + scene.image}
              alt=""
              width="160"
              height="90"
              loading="lazy"
            />
            <span>{String(index + 1).padStart(2, "0")}</span>
          </button>
          <button
            type="button"
            class="scene-preview"
            data-preview-case={scene.id}
            data-image={base + scene.image}
            data-full-image={base + (fullImage?.path ?? scene.image)}
            data-prompt={scene.prompt}
            aria-label={`Preview scene ${index + 1}: ${scene.prompt}`}
            aria-haspopup="dialog"
            aria-controls="condition-dialog"
            title={`Preview scene ${index + 1}`}
          >
            <Icon name="ri:zoom-in-line" aria-hidden="true" />
          </button>
        </div>
      );
    })
  }
</div>
