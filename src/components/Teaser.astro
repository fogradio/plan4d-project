---
import { Icon } from "astro-icon/components";
import teaser from "../data/teaser.json";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const media = base + teaser.directory + teaser.basename;
---

<figure class="teaser content-shell" id="teaser">
  <video
    id="teaser-video"
    width="1280"
    height="720"
    poster={media + "-poster.webp"}
    muted
    loop
    playsinline
    controls
    preload="metadata"
    aria-label="Plan4D: one image and a text action generate a future video, depth, dynamic 4D geometry and tracked motion."
    aria-describedby="teaser-caption"
  >
    <source src={media + ".mp4"} type="video/mp4" />
    <source src={media + ".webm"} type="video/webm" />
    <a href={media + ".mp4"}>Download the Plan4D teaser</a>
  </video>
  <figcaption id="teaser-caption">
    <span
      ><strong>One image + text. A generated 4D future.</strong> Future RGB, depth,
      and dynamic geometry from a single observed frame and an action. Tracks are
      visualized from the generated RGB and predicted geometry.</span
    >
    <a
      class="teaser-download"
      href={media + "-1080p.mp4"}
      download
      title="Download the 1080p teaser"
      ><Icon name="ri:download-2-line" /> 1080p</a
    >
  </figcaption>
</figure>

<script>
  const video = document.querySelector<HTMLVideoElement>("#teaser-video")!;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let visible = false;
  let userPaused = false;
  let automaticPause = false;

  function syncPlayback() {
    if (!visible || document.hidden || reducedMotion.matches) {
      if (!video.paused) {
        automaticPause = true;
        video.pause();
      }
    } else if (!userPaused) {
      void video.play().catch(() => {});
    }
  }

  video.addEventListener("pause", () => {
    if (automaticPause) automaticPause = false;
    else userPaused = true;
  });
  video.addEventListener("play", () => {
    userPaused = false;
  });
  const observer = new IntersectionObserver(
    ([entry]) => {
      visible = entry.isIntersecting;
      syncPlayback();
    },
    { threshold: 0.15 },
  );
  observer.observe(video);
  document.addEventListener("visibilitychange", syncPlayback);
  reducedMotion.addEventListener("change", syncPlayback);
</script>
