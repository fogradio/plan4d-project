---
import { Icon } from "astro-icon/components";
import ResultsComparison from "../components/ResultsComparison.astro";
import AggregatedComparison from "../components/AggregatedComparison.astro";
import Gallery from "../components/Gallery.astro";
import Teaser from "../components/Teaser.astro";
import "../styles/plan4d.css";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const title = "Plan4D: Generative Plannable 4D Worlds";
const description =
  "Plan4D predicts future RGB video and dense 4D geometry from an observed scene and text-specified actions.";
const authors = [
  ["Hangwei Zhang", "1,2"],
  ["Rujing Dang", "2"],
  ["Ruimin Lin", "2"],
  ["Jiahong Wu", "2,†"],
  ["Xiangxiang Chu", "2"],
  ["Chuanxia Zheng", "1,†"],
];
const citation = `@inproceedings{zhang2026plan4d,
  title     = {Plan4D: Generative Plannable 4D Worlds},
  author    = {Zhang, Hangwei and Dang, Rujing and Lin, Ruimin and
               Wu, Jiahong and Chu, Xiangxiang and Zheng, Chuanxia},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  year      = {2026}
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content={base + "results/teaser/plan4d-teaser-poster.webp"}
    />
    <link rel="icon" href={base + "plan4d.svg"} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="nav-shell" aria-label="Main navigation">
        <a class="wordmark" href="#top"
          >Plan<span>4D</span><span class="wordmark-square" aria-hidden="true"
          ></span></a
        >
        <div class="nav-links">
          <a href="#abstract">Abstract</a><a href="#method">Method</a><a
            href="#comparisons">Comparisons</a
          ><a href="#gallery">Gallery</a><a href="#citation">BibTeX</a>
        </div>
      </nav>
    </header>
    <main id="main">
      <section class="paper-heading content-shell" id="top">
        <h1 class="paper-title">
          <span class="paper-name">Plan<span>4D</span>:</span> Generative Plannable
          4D Worlds
        </h1>
        <p class="paper-conference">NeurIPS 2026</p>
        <div class="authors">
          {
            authors.map(([name, affiliation]) => (
              <span>
                {name}
                <sup>{affiliation}</sup>
              </span>
            ))
          }
        </div>
        <p class="affiliations">
          <span><sup>1</sup> PVG, Nanyang Technological University</span><span
            ><sup>2</sup> AMAP, Alibaba Group</span
          >
        </p>
        <p class="author-note">† Corresponding authors</p>
        <div class="paper-links">
          <button
            class="action-link"
            type="button"
            disabled
            title="Paper link coming soon"
            ><Icon name="ri:file-pdf-2-line" /> Paper</button
          ><button
            class="action-link"
            type="button"
            disabled
            title="Code link coming soon"
            ><Icon name="ri:github-line" /> Code</button
          ><button
            class="action-link"
            type="button"
            disabled
            title="Model link coming soon"
            ><Icon name="ri:box-3-line" /> Model</button
          ><a class="action-link primary-link" href="#citation"
            ><Icon name="ri:double-quotes-l" /> BibTeX</a
          >
        </div>
      </section>

      <Teaser />

      <section class="section abstract-section" id="abstract">
        <div class="text-shell">
          <h2>Abstract</h2>
          <p>
            Most world models for future prediction prioritize the aesthetic
            quality of generated videos, but offer only limited geometric
            consistency over time, due to the lack of explicit 4D modeling. In
            this paper, we introduce Plan4D, a possible next milestone towards
            building a <em>generative plannable 4D world model</em> that predicts
            future RGB videos together with dense 4D geometry, including depth, cameras,
            point clouds, and scene flow, from an observed scene context and text-specified
            actions. Since training data with paired actions and dense 4D annotations
            is inherently scarce, Plan4D leverages the complementary priors of foundational
            video generators and 3D reconstructors. Specifically, we propose a model-stitching
            architecture that couples Depth Anything 3 with LongCat-Video and augments
            it with an auxiliary DPT head for scene-flow prediction. The resulting
            model allows us to plan and generate complex, long-horizon, and fine-grained
            actions in dynamic 3D scenes, while substantially improving both visual
            fidelity and geometric accuracy of the generated future videos. Extensive
            experiments on both synthetic and real-world datasets demonstrate that
            Plan4D achieves state-of-the-art performance in generative 4D modeling
            of environmental reactions.
          </p>
        </div>
        <div class="contributions content-shell">
          <div>
            <span class="contribution-number">01</span><h3>
              Action-conditioned futures
            </h3><p>
              Observed context and a planned action specify how the scene
              evolves.
            </p>
          </div><div>
            <span class="contribution-number">02</span><h3>
              A shared latent trajectory
            </h3><p>
              RGB, depth, cameras, and scene flow are synchronized readouts of
              one generated world.
            </p>
          </div><div>
            <span class="contribution-number">03</span><h3>
              Geometry-guided generation
            </h3><p>
              A frozen stitched decoder provides geometric supervision to the
              video generator.
            </p>
          </div>
        </div>
      </section>

      <ResultsComparison />
      <AggregatedComparison />
      <Gallery />

      <section class="section" id="method">
        <div class="section-heading content-shell">
          <div>
            <p class="eyebrow">The framework</p><h2>
              Two foundation models. One 4D world.
            </h2><p class="section-description">
              A latent-to-geometry connection joins a video generator with a
              dynamic 3D reconstruction model.
            </p>
          </div>
        </div>
        <figure class="method-figure content-shell">
          <img
            src={base + "figures/method-chuanxia-20261014.webp"}
            alt="Plan4D architecture: LongCat-Video generates a latent trajectory, a stitching module maps it into DA3 tokens, and dense heads decode depth, camera rays and scene flow."
            loading="lazy"
            width="2447"
            height="657"
          /><figcaption>
            <strong>Overview of the Plan4D pipeline.</strong> A video generator produces
            a denoised latent trajectory, while a stitched DA3 decoder reads the same
            latent state to recover synchronized depth, camera rays, camera parameters,
            point clouds, and scene flow. During joint training, the stitched decoder
            is frozen and acts as a differentiable geometry critic for the video generator;
            at inference time, RGB video and dense 4D structure are decoded from the
            shared latent trajectory.
          </figcaption>
        </figure>
        <div class="method-steps content-shell">
          <div>
            <span>01 / Motion</span><h3>Read out scene flow</h3><p>
              A DPT-style motion head predicts dense 3D displacements from
              frozen DA3 features.
            </p>
          </div><div>
            <span>02 / Stitching</span><h3>Connect latent and geometry</h3><p>
              A compact spatiotemporal projection maps video latents into the
              reconstruction backbone.
            </p>
          </div><div>
            <span>03 / Calibration</span><h3>Preserve geometric priors</h3><p>
              Teacher distillation and annotated geometry calibrate the stitched
              decoder.
            </p>
          </div><div>
            <span>04 / Joint training</span><h3>Ground future generation</h3><p>
              Flow matching and geometric supervision shape a visually and
              spatially consistent rollout.
            </p>
          </div>
        </div>
      </section>

      <section class="section citation-section text-shell" id="citation">
        <div class="section-heading">
          <div><p class="eyebrow">Reference</p><h2>BibTeX</h2></div><button
            class="icon-button"
            id="copy-citation"
            title="Copy BibTeX"
            aria-label="Copy BibTeX"><Icon name="ri:file-copy-line" /></button
          >
        </div><pre><code id="citation-text">{citation}</code></pre><p
          id="copy-status"
          role="status"
          aria-live="polite"
        >
        </p>
      </section>
    </main>
    <footer class="site-footer content-shell">
      <a class="wordmark" href="#top">Plan<span>4D</span></a><p>
        Nanyang Technological University &amp; AMAP, Alibaba Group
      </p><a
        href="https://github.com/RomanHauksson/academic-project-astro-template"
        rel="nofollow">Template credit <Icon name="ri:arrow-right-up-line" /></a
      >
    </footer>
    <script>
      import "../scripts/page";
    </script>
  </body>
</html>
